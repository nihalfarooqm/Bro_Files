   ],
   "source": [
    "import pandas as pd\n",
    "\n",
    "df = pd.DataFrame({\n",
    "    'city': ['Delhi', 'Mumbai', 'Delhi', 'Chennai'],\n",
    "    'salary': [50, 60, 55, 45]\n",
    "})\n",
    "\n",
    "# Feature Engineering\n",
    "df['salary_squared'] = df['salary'] ** 2\n",
    "\n",
    "# One-hot encoding\n",
    "df_encoded = pd.get_dummies(df, columns=['city'])\n",
    "\n",
    "print(df_encoded)\n"
   ]
  },
