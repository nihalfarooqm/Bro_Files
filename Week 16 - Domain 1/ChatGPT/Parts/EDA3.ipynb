   "source": [
    "import pandas as pd\n",
    "import seaborn as sns\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "df = pd.DataFrame({\n",
    "    'age': [25, 30, 35, 40],\n",
    "    'salary': [30, 40, 50, 60],\n",
    "    'experience': [1, 5, 7, 10]\n",
    "})\n",
    "\n",
    "corr = df.corr()\n",
    "\n",
    "sns.heatmap(corr, annot=True)\n",
    "plt.show()\n"
   ]
  },
