   "source": [
    "def f(x):\n",
    "    return x**2\n",
    "def grad(x):\n",
    "    return 2 * x"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "ccdc521f-8cba-49a8-b575-a69dd3bbcdec",
