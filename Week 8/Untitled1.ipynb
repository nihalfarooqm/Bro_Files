   "outputs": [],
   "source": [
    "x = 4\n",
    "learning_rate = 0.1\n",
    "steps = 20\n",
    "path = [x]\n",
    "for _ in range(steps):\n",
    "    x = x - learning_rate * grad(x)\n",
    "    path.append(x)"
   ]
  }
