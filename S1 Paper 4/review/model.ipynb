   "source": [
    "from sklearn.linear_model import LogisticRegression\n",
    "import joblib\n",
    "\n",
    "X = [\n",
    "    [20, 20000],\n",
    "    [25, 30000],\n",
    "    [30, 40000],\n",
    "    [35, 50000],\n",
    "    [40, 60000],\n",
    "    [45, 70000]\n",
    "]\n",
    "\n",
    "y = [0, 0, 0, 1, 1, 1]\n",
    "\n",
    "model = LogisticRegression()\n",
    "\n",
    "model.fit(X, y)\n",
    "\n",
    "joblib.dump(model, \"model.joblib\")"
   ]
  },
